# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5442/control_machine?sslmode=disable

# LLM: openai | ollama | auto (openai when OPENAI_API_KEY is set)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest

# Container browser slots (ports match docker-compose.yml)
BROWSER_SLOT_COUNT=2
BROWSER_CDP_BASE_PORT=9231
BROWSER_NOVNC_BASE_PORT=6081
BROWSER_HOST=127.0.0.1
MAX_PARALLEL_RUNS=2
# Keep a completed conversation's browser warm for follow-up messages.
BROWSER_SESSION_IDLE_SECONDS=900

# Dashboard
HOST=127.0.0.1
PORT=8100
# Public URL of this process (ngrok https URL). Telegram Open-desktop buttons need https.
PUBLIC_BASE_URL=
LIVE_LINK_SECRET=
# LIVE_LINK_TTL_SECONDS=86400
# Factory JSON bearer. Both must be set or login is refused. Not table columns.
# FACTORY_ACCESS_KEY=
# FACTORY_SESSION_SECRET=
# FACTORY_SESSION_TTL_SECONDS=43200

# Telegram operator (leave token empty to disable)
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to talk to the bot.
TELEGRAM_ALLOWLIST=
# Chat that receives live links when an automation needs a human.
TELEGRAM_NOTIFY_CHAT_ID=

# Host filesystem. Empty FILESYSTEM_ROOT means the current user's home.
# FILESYSTEM_ROOT=
# Extra deny prefixes relative to that root, comma-separated.
# FILESYSTEM_DENY=
# FILESYSTEM_READ_MAX_BYTES=256000
# FILESYSTEM_WRITE_MAX_BYTES=1000000
# FILESYSTEM_DOWNLOAD_MAX_BYTES=20000000

# This Mac's Screen Sharing (System Settings → General → Sharing).
# Enable “VNC viewers may control screen with password”.
DESKTOP_VNC_HOST=127.0.0.1
DESKTOP_VNC_PORT=5900

# Agent guardrails
MAX_STEPS=40
RUN_TIMEOUT_SECONDS=600
# Comma-separated domain suffixes the agent may navigate to without approval.
# Leave empty to allow any domain without an approval prompt.
DOMAIN_ALLOWLIST=

# Local traces and errors. Empty LOG_DIR means <project>/logs.
# LOG_DIR=
# LOG_LEVEL=INFO
