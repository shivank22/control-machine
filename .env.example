# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5442/control_machine?sslmode=disable

# LLM: openai | ollama | auto (openai when OPENAI_API_KEY is set)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest

# Container browser slots (ports match docker-compose.yml)
BROWSER_SLOT_COUNT=2
BROWSER_CDP_BASE_PORT=9231
BROWSER_NOVNC_BASE_PORT=6081
BROWSER_HOST=127.0.0.1
MAX_PARALLEL_RUNS=2
# Keep a completed conversation's browser warm for follow-up messages.
BROWSER_SESSION_IDLE_SECONDS=900

# Dashboard
HOST=127.0.0.1
PORT=8100

# Agent guardrails
MAX_STEPS=40
RUN_TIMEOUT_SECONDS=600
# Comma-separated domain suffixes the agent may navigate to without approval.
# Leave empty to allow any domain without an approval prompt.
DOMAIN_ALLOWLIST=
